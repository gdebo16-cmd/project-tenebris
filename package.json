{
  "name": "tenebris",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "meshoptimizer": "^1.3.0",
    "node-pg-migrate": "^9.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "textures:check": "node scripts/check-textures.mjs",
    "migrate": "node db/migrate.js",
    "content:build": "node packages/content/build.ts",
    "migrate:create": "node-pg-migrate create --migrations-dir db/migrations --migration-file-language js",
    "test": "node --test \"packages/rules/test/**/*.test.ts\"",
    "typecheck": "tsc -p packages/rules && tsc -p packages/rules/test && tsc -p apps/server && tsc -p apps/web",
    "model": "node scripts/model.mjs",
    "library:generate": "node scripts/generate-library.mjs",
    "library:import": "node scripts/import-polyhaven.mjs",
    "models:check": "node scripts/check-models.mjs"
  }
}

{
  "name": "tenebris",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "migrate": "node db/migrate.js",
    "migrate:create": "node-pg-migrate create --migrations-dir db/migrations --migration-file-language js",
    "typecheck": "tsc -p packages/rules && tsc -p apps/server && tsc -p apps/web"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // Old .js/.jsx files are allowed but not checked yet; each becomes .ts/.tsx as it is rebuilt.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
